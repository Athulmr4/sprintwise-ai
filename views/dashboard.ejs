
<%- include("partials/head") %>

<div class="min-h-screen">
    <header class="border-b border-slate-800">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">
            <a href="/" class="text-xl font-bold">
                SprintWise<span class="text-indigo-500">AI</span>
            </a>

            <div class="flex items-center gap-4">
                <span class="hidden text-sm text-slate-400 sm:inline">
                    Project workspace
                </span>
                <button
                    id="logout-button"
                    class="rounded-lg border border-slate-700 px-4 py-2 text-sm hover:bg-slate-900"
                >
                    Log out
                </button>
            </div>
        </div>
    </header>

    <main class="mx-auto max-w-7xl px-6 py-10">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
            <div>
                <p class="text-sm font-medium uppercase tracking-widest text-indigo-400">
                    Overview
                </p>
                <h1 class="mt-2 text-3xl font-bold">Dashboard</h1>
                <p class="mt-2 text-slate-400">
                    A live overview of your projects and tasks.
                </p>
            </div>

            <button
                id="refresh-button"
                class="rounded-lg border border-slate-700 px-4 py-2 text-sm hover:bg-slate-900"
            >
                Refresh data
            </button>
        </div>

        <p id="dashboard-message" role="status" class="mt-6 text-sm text-slate-400">
            Loading dashboard data...
        </p>

        <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
                <p class="text-sm text-slate-400">Total projects</p>
                <p id="total-projects" class="mt-3 text-3xl font-bold">—</p>
                <p class="mt-2 text-xs text-slate-500">Projects you belong to</p>
            </article>

            <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
                <p class="text-sm text-slate-400">Active projects</p>
                <p id="active-projects" class="mt-3 text-3xl font-bold">—</p>
                <p class="mt-2 text-xs text-slate-500">Currently in progress</p>
            </article>

            <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
                <p class="text-sm text-slate-400">Total tasks</p>
                <p id="total-tasks" class="mt-3 text-3xl font-bold">—</p>
                <p class="mt-2 text-xs text-slate-500">Across your projects</p>
            </article>

            <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
                <p class="text-sm text-slate-400">Overdue tasks</p>
                <p id="overdue-tasks" class="mt-3 text-3xl font-bold">—</p>
                <p class="mt-2 text-xs text-slate-500">Past due and not completed</p>
            </article>
        </section>

        <section class="mt-6 grid gap-6 lg:grid-cols-2">
            <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
                <h2 class="text-lg font-semibold">Task status</h2>
                <p class="mt-1 text-sm text-slate-400">
                    How tasks are progressing
                </p>
                <div class="relative mx-auto mt-6 h-72 max-w-md">
                    <canvas id="status-chart" aria-label="Task status distribution"></canvas>
                </div>
            </article>

            <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
                <h2 class="text-lg font-semibold">Task priority</h2>
                <p class="mt-1 text-sm text-slate-400">
                    Tasks grouped by priority
                </p>
                <div class="relative mt-6 h-72">
                    <canvas id="priority-chart" aria-label="Task priority distribution"></canvas>
                </div>
            </article>
        </section>

        <section class="mt-6 rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
            <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
                <div>
                    <h2 class="text-lg font-semibold">Overall completion</h2>
                    <p class="mt-1 text-sm text-slate-400">
                        Percentage of tasks marked completed
                    </p>
                </div>
                <p id="completion-rate" class="text-3xl font-bold text-indigo-400">—</p>
            </div>

            <div
                class="mt-5 h-3 overflow-hidden rounded-full bg-slate-800"
                role="progressbar"
                aria-label="Overall task completion"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
                id="completion-progress"
            >
                <div
                    id="completion-bar"
                    class="h-full rounded-full bg-indigo-500 transition-all duration-500"
                    style="width: 0%"
                ></div>
            </div>
        </section>

        <section class="mt-8">
            <div class="mb-5">
                <h2 class="text-xl font-bold">Recent Projects</h2>
                <p class="mt-1 text-sm text-slate-400">
                    Track progress across your projects.
                </p>
            </div>

            <p id="projects-message" class="mb-4 text-sm text-slate-400">
                Loading projects...
            </p>

            <div
                id="recent-projects"
                class="grid gap-5 md:grid-cols-2 xl:grid-cols-3"
            ></div>
        </section>

    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/dashboard.js" defer></script>
</body>
</html>
