<%- include("partials/head") %>

<%- include("partials/navbar") %>

<main>

    <!-- Hero -->
    <section class="px-6 py-24">

        <div class="mx-auto max-w-5xl text-center">

            <p class="mb-6 text-sm font-medium uppercase tracking-widest text-indigo-400">
                AI-Powered Project Management
            </p>

            <h1 class="text-5xl font-bold tracking-tight sm:text-6xl lg:text-7xl">
                Plan smarter.
                <span class="text-indigo-500">Build faster.</span>
            </h1>

            <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-400">
                SprintWise AI helps teams plan projects, manage tasks,
                collaborate efficiently, and use AI to make better decisions.
            </p>

            <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">

                <a
                    href="#"
                    class="rounded-lg bg-indigo-600 px-6 py-3 font-medium transition hover:bg-indigo-500"
                >
                    Get Started
                </a>

                <a
                    href="#features"
                    class="rounded-lg border border-slate-700 px-6 py-3 font-medium transition hover:bg-slate-900"
                >
                    Explore Features
                </a>

            </div>

        </div>

    </section>
    <!-- Core Features -->
<section id="features" class="border-t border-slate-800 px-6 py-24">

    <div class="mx-auto max-w-7xl">

        <!-- Section Heading -->
        <div class="mx-auto max-w-2xl text-center">

            <p class="text-sm font-medium uppercase tracking-widest text-indigo-400">
                Everything your team needs
            </p>

            <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
                Manage projects from idea to completion
            </h2>

            <p class="mt-4 text-lg leading-8 text-slate-400">
                SprintWise AI brings project planning, task management,
                collaboration and intelligent insights into one workspace.
            </p>

        </div>


        <!-- Feature Cards -->
        <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

            <!-- Feature 1 -->
            <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 transition hover:-translate-y-1 hover:border-indigo-500/50">

                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-500/10 text-indigo-400">
                    ✓
                </div>

                <h3 class="mt-6 text-lg font-semibold">
                    Smart Task Management
                </h3>

                <p class="mt-3 text-sm leading-6 text-slate-400">
                    Create, assign, prioritize and track tasks while keeping
                    deadlines and project progress under control.
                </p>

            </div>


            <!-- Feature 2 -->
            <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 transition hover:-translate-y-1 hover:border-indigo-500/50">

                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-500/10 text-indigo-400">
                    +
                </div>

                <h3 class="mt-6 text-lg font-semibold">
                    Team Collaboration
                </h3>

                <p class="mt-3 text-sm leading-6 text-slate-400">
                    Work together with comments, team members, notifications
                    and activity tracking in one centralized workspace.
                </p>

            </div>


            <!-- Feature 3 -->
            <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 transition hover:-translate-y-1 hover:border-indigo-500/50">

                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-500/10 text-indigo-400">
                    ↗
                </div>

                <h3 class="mt-6 text-lg font-semibold">
                    Project Analytics
                </h3>

                <p class="mt-3 text-sm leading-6 text-slate-400">
                    Understand project progress, workload, deadlines and
                    performance through meaningful analytics and reports.
                </p>

            </div>


            <!-- Feature 4 -->
            <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 transition hover:-translate-y-1 hover:border-indigo-500/50">

                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-500/10 text-indigo-400">
                    AI
                </div>

                <h3 class="mt-6 text-lg font-semibold">
                    AI-Powered Insights
                </h3>

                <p class="mt-3 text-sm leading-6 text-slate-400">
                    Break down tasks, plan sprints, detect project risks and
                    generate useful insights using AI.
                </p>

            </div>

        </div>

    </div>

</section>

    <!-- AI Features -->

    <section id="ai" class="border-t border-slate-800 px-6 py-24">

        <div class="mx-auto max-w-7xl">

            <!-- Section Heading -->

            <div class="mx-auto max-w-2xl text-center">

                <p class="text-sm font-medium uppercase tracking-widest text-indigo-400">
                    Intelligence built into your workflow
                </p>

                <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
                    Let AI handle the planning
                </h2>

                <p class="mt-4 text-lg leading-8 text-slate-400">
                    SprintWise AI turns project data into useful recommendations,
                    helping your team plan better, identify risks and stay on track.
                </p>

            </div>


            <!-- AI Feature Grid -->

            <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">


                <!-- AI Task Breakdown -->

                <div class="rounded-2xl border border-indigo-500/20 bg-indigo-500/5 p-6 transition hover:-translate-y-1 hover:border-indigo-500/50">

                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-500/10 text-sm font-bold text-indigo-400">
                        AI
                    </div>

                    <h3 class="mt-6 text-lg font-semibold">
                        AI Task Breakdown
                    </h3>

                    <p class="mt-3 text-sm leading-6 text-slate-400">
                        Turn a project goal into smaller, actionable tasks with
                        suggested priorities, dependencies and estimated effort.
                    </p>

                </div>


                <!-- AI Sprint Planner -->

                <div class="rounded-2xl border border-indigo-500/20 bg-indigo-500/5 p-6 transition hover:-translate-y-1 hover:border-indigo-500/50">

                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-500/10 text-sm font-bold text-indigo-400">
                        SP
                    </div>

                    <h3 class="mt-6 text-lg font-semibold">
                        AI Sprint Planner
                    </h3>

                    <p class="mt-3 text-sm leading-6 text-slate-400">
                        Generate realistic sprint plans based on deadlines,
                        task estimates, priorities and team capacity.
                    </p>

                </div>


                <!-- AI Project Summary -->

                <div class="rounded-2xl border border-indigo-500/20 bg-indigo-500/5 p-6 transition hover:-translate-y-1 hover:border-indigo-500/50">

                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-500/10 text-sm font-bold text-indigo-400">
                        PS
                    </div>

                    <h3 class="mt-6 text-lg font-semibold">
                        AI Project Summary
                    </h3>

                    <p class="mt-3 text-sm leading-6 text-slate-400">
                        Get a concise overview of project progress, completed
                        work, remaining tasks and potential delays.
                    </p>

                </div>


                <!-- AI Risk Detection -->

                <div class="rounded-2xl border border-indigo-500/20 bg-indigo-500/5 p-6 transition hover:-translate-y-1 hover:border-indigo-500/50">

                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-500/10 text-sm font-bold text-indigo-400">
                        RD
                    </div>

                    <h3 class="mt-6 text-lg font-semibold">
                        AI Risk Detection
                    </h3>

                    <p class="mt-3 text-sm leading-6 text-slate-400">
                        Identify overdue work, blocked tasks, dependency issues
                        and deadlines that could put a project at risk.
                    </p>

                </div>


                <!-- AI Workload Analysis -->

                <div class="rounded-2xl border border-indigo-500/20 bg-indigo-500/5 p-6 transition hover:-translate-y-1 hover:border-indigo-500/50">

                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-500/10 text-sm font-bold text-indigo-400">
                        WA
                    </div>

                    <h3 class="mt-6 text-lg font-semibold">
                        AI Workload Analysis
                    </h3>

                    <p class="mt-3 text-sm leading-6 text-slate-400">
                        Analyze team workload and receive suggestions for
                        balancing tasks across available team members.
                    </p>

                </div>


                <!-- Meeting to Tasks -->

                <div class="rounded-2xl border border-indigo-500/20 bg-indigo-500/5 p-6 transition hover:-translate-y-1 hover:border-indigo-500/50">

                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-500/10 text-sm font-bold text-indigo-400">
                        MT
                    </div>

                    <h3 class="mt-6 text-lg font-semibold">
                        Meeting → Tasks
                    </h3>

                    <p class="mt-3 text-sm leading-6 text-slate-400">
                        Convert meeting notes into structured tasks, priorities
                        and deadlines that your team can review and approve.
                    </p>

                </div>

            </div>

        </div>

    </section>

</main>

<%- include("partials/footer") %>